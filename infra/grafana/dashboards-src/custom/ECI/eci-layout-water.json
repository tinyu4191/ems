      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ems-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\r\n  SELECT\r\n    DISTINCT ON (meter_id) meter_id,\r\n    flow_rate_m3h\r\n  FROM\r\n    realtime_water\r\n  WHERE\r\n    meter_id IN (\r\n      'W-DYE1',\r\n      'W-DYE2',\r\n      'W-IN2',\r\n      'W-IN1'\r\n    )\r\n  ORDER BY\r\n    meter_id,\r\n    time DESC\r\n)\r\nSELECT\r\n  MAX(flow_rate_m3h) FILTER (\r\n    WHERE\r\n      meter_id = 'W-DYE1'\r\n  ) AS \"DYE1_m3h\",\r\n  MAX(flow_rate_m3h) FILTER (\r\n    WHERE\r\n      meter_id = 'W-DYE2'\r\n  ) AS \"DYE2_m3h\",\r\n  MAX(flow_rate_m3h) FILTER (\r\n    WHERE\r\n      meter_id = 'W-IN2'\r\n  ) AS \"IN2_m3h\",\r\n  MAX(flow_rate_m3h) FILTER (\r\n    WHERE\r\n      meter_id = 'W-IN1'\r\n  ) AS \"IN1_m3h\"\r\nFROM\r\n  latest;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
