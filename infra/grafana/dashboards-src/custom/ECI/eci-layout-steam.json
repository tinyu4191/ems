          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\r\n  SELECT\r\n    DISTINCT ON (meter_id) meter_id,\r\n    flow_rate_kgh,\r\n    pressure_bar,\r\n    temperature_c\r\n  FROM\r\n    realtime_steam\r\n  WHERE\r\n    meter_id IN (\r\n      'S-DYE1',\r\n      'S-BOIL',\r\n      'S-DYE2'\r\n    )\r\n  ORDER BY\r\n    meter_id,\r\n    time DESC\r\n)\r\nSELECT\r\n  MAX(flow_rate_kgh) FILTER (\r\n    WHERE\r\n      meter_id = 'S-DYE1'\r\n  ) AS \"DYE1_kgh\",\r\n  MAX(pressure_bar) FILTER (\r\n    WHERE\r\n      meter_id = 'S-DYE1'\r\n  ) AS \"DYE1_bar\",\r\n  MAX(temperature_c) FILTER (\r\n    WHERE\r\n      meter_id = 'S-DYE1'\r\n  ) AS \"DYE1_c\",\r\n  MAX(flow_rate_kgh) FILTER (\r\n    WHERE\r\n      meter_id = 'S-BOIL'\r\n  ) AS \"BOIL_kgh\",\r\n  MAX(pressure_bar) FILTER (\r\n    WHERE\r\n      meter_id = 'S-BOIL'\r\n  ) AS \"BOIL_bar\",\r\n  MAX(temperature_c) FILTER (\r\n    WHERE\r\n      meter_id = 'S-BOIL'\r\n  ) AS \"BOIL_c\",MAX(flow_rate_kgh) FILTER (\r\n    WHERE\r\n      meter_id = 'S-DYE2'\r\n  ) AS \"DYE2_kgh\",\r\n  MAX(pressure_bar) FILTER (\r\n    WHERE\r\n      meter_id = 'S-DYE2'\r\n  ) AS \"DYE2_bar\",\r\n  MAX(temperature_c) FILTER (\r\n    WHERE\r\n      meter_id = 'S-DYE2'\r\n  ) AS \"DYE2_c\"\r\nFROM\r\n  latest;",
