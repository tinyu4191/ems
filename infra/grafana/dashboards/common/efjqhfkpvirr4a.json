        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ems-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_trunc('day', NOW()) AS time,\n  m.zone,\n  SUM(GREATEST(sub.kwh, 0)) AS kwh_consumed\nFROM (\n  SELECT\n    meter_id,\n    last(total_kwh, time) - first(total_kwh, time) AS kwh\n  FROM accumulator_electricity\n  WHERE $__timeFilter(time)\n    AND meter_id NOT LIKE '%ATS%'\n  GROUP BY meter_id\n) sub\nJOIN meters m USING (meter_id)\nGROUP BY m.zone\nORDER BY time ASC, kwh_consumed DESC",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "timeFrom": "now/d",
      "title": "【本日】用電占比",
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "kwh_consumed (.*)",
            "renamePattern": "$1"
          }
        }
      ],
