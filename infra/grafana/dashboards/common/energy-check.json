          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT \r\n  a.meter_id,\r\n  a.avg_kw_before,\r\n  b.avg_kw_after,\r\n  ROUND((b.avg_kw_after / NULLIF(a.avg_kw_before, 0))::numeric, 2) AS ratio\r\nFROM (\r\n  SELECT \r\n    meter_id,\r\n    ROUND(AVG(power_kw)::numeric, 2) AS avg_kw_before\r\n  FROM realtime_electricity\r\n  WHERE time >= '2026-04-23 00:00:00+00'\r\n    AND time <  '2026-04-23 07:24:00+00'\r\n  GROUP BY meter_id\r\n) a\r\nJOIN (\r\n  SELECT \r\n    meter_id,\r\n    ROUND(AVG(power_kw)::numeric, 2) AS avg_kw_after\r\n  FROM realtime_electricity\r\n  WHERE time >= '2026-04-23 07:24:00+00'\r\n  GROUP BY meter_id\r\n) b ON a.meter_id = b.meter_id\r\nWHERE a.meter_id IN ('E-ATS1', 'E-ATS2')\r\nORDER BY a.meter_id;",
          "refId": "B",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
