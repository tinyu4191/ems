      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ems-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\r\n  time_bucket('1 minute', r.time) AS time,\r\n  SUM(r.power_kw) FILTER (WHERE r.meter_id = 'E-ATS1') AS \"ATS1\",\r\n  SUM(r.power_kw) FILTER (WHERE r.meter_id = 'E-ATS2') AS \"ATS2\",\r\n  SUM(r.power_kw) FILTER (WHERE r.meter_id = 'E-ATS1') \r\n    + SUM(r.power_kw) FILTER (WHERE r.meter_id = 'E-ATS2') AS \"進線合計\",\r\n  SUM(r.power_kw) FILTER (WHERE m.is_main = false) AS \"子迴路合計\",\r\n  SUM(r.power_kw) FILTER (WHERE r.meter_id = 'E-ATS1')\r\n    + SUM(r.power_kw) FILTER (WHERE r.meter_id = 'E-ATS2')\r\n    - SUM(r.power_kw) FILTER (WHERE m.is_main = false) AS \"差值\"\r\nFROM realtime_electricity r\r\nJOIN meters m USING (meter_id)\r\nWHERE $__timeFilter(r.time)\r\n  AND m.meter_type = 'electricity'\r\nGROUP BY time_bucket('1 minute', r.time)\r\nORDER BY time asc;",
          "refId": "B",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
