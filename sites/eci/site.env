# =============================================
# sites/eci/site.env
#
# 這個站點目前指到哪一份 core 版本清單。
# scripts/deploy-site.sh 依此讀取 releases/<CORE_RELEASE>.env 來決定各服務要用哪個版本。
#
# 這個檔案跟 root .env（DB_NAME/DB_USER/DB_PASS/...）、collector/.env（GW_xx_HOST 等機密）
# 是分開的：這裡只放「這個站點跑哪個 release」，機密設定不動、不重複。
# =============================================

SITE_ID=eci
CORE_RELEASE=core-1.0.0
