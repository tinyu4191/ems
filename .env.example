# ems 正式環境設定
# 複製這份檔案為 .env，並依需要調整

# ── Port 對外映射 ──────────────────────────────────
# 舊環境（ems-dev）佔用 5432/3000，這裡刻意錯開，避免衝突
DB_PORT=5433
GRAFANA_PORT=3001
WEB_PORT=8080

# ── DB ─────────────────────────────────────────────
DB_NAME=ems
DB_USER=admin
DB_PASS=ems123456

# ── Retention ──────────────────────────────────────
RETENTION_DAYS=180
